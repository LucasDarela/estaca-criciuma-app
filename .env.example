# Documente aqui TODA variável de ambiente que o projeto usa, com valor fictício.
# Copie para .env e preencha com os valores reais (o .env nunca é versionado).
# Agentes de IA leem este arquivo, mas não o .env.

# --- App (Expo) ---------------------------------------------------------
# EXPO_PUBLIC_* é embutido no app e é PÚBLICO. Nunca coloque segredo aqui.
# Valores possíveis: http://localhost:54321 (local) e https://<project-ref>.supabase.co (preview e
# produção usam o mesmo projeto). O project-ref real fica no gerenciador de senhas.
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
# Publishable key do Supabase (painel › Project Settings › API Keys; começa com sb_publishable_).
# É a antiga "anon key": pública, respeita o RLS.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ficticia
# URL da política de privacidade (https://). A estaca publica a política; sem a variável, o link
# não aparece no app.
EXPO_PUBLIC_PRIVACY_URL=https://exemplo.org/privacidade
EXPO_PUBLIC_SENTRY_DSN=https://chave@o0.ingest.sentry.io/0

# --- Build (EAS Secrets / CI de release; nunca no app) ------------------
SENTRY_AUTH_TOKEN=sntrys_ficticio
EXPO_TOKEN=expo-token-ficticio
# Arquivo google-services.json do projeto Firebase do app Android (push via FCM). Na EAS é uma
# variável de arquivo (eas env:create, tipo file); local, o arquivo fica na raiz e fora do git.
GOOGLE_SERVICES_JSON=./google-services.json

# --- Supabase Edge Functions (secrets do servidor; nunca no app) --------
# Secret key do Supabase (começa com sb_secret_; é a antiga service_role). Ignora o RLS:
# só em Edge Functions e servidor, nunca no app, no repositório ou no chat.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_ficticia
EXPO_ACCESS_TOKEN=expo-access-token-ficticio
