# Template of /opt/estaca/<env>/.env. Every value here is a fictitious placeholder.
# provision-env.sh copies it on first run and generates or asks for the real values.
# Real secrets live only on the server (mode 600) and in the admin password manager.

############
# Composition and ports (set by provision-env.sh)
############

# Filled by provision-env.sh: compose files layered over the upstream docker-compose.yml.
COMPOSE_FILE=set-by-provision-env
# Filled by provision-env.sh: Compose project name (estaca-<env>).
COMPOSE_PROJECT_NAME=set-by-provision-env
# Filled by provision-env.sh: hml or prod; prefixes container names.
ENV_NAME=set-by-provision-env
# Filled by provision-env.sh: loopback port of the API gateway (Envoy).
HOST_GW_PORT=set-by-provision-env
# Filled by provision-env.sh: loopback port of Studio (SSH tunnel only).
HOST_STUDIO_PORT=set-by-provision-env
# Filled by provision-env.sh: loopback port of Postgres (SSH tunnel only).
HOST_DB_PORT=set-by-provision-env

############
# Secrets generated by utils/generate-keys.sh from the upstream (via provision-env.sh)
############

# Generated by provision-env.sh (upstream generate-keys.sh); never edit by hand. Postgres superuser password.
POSTGRES_PASSWORD=generated-by-provision-env
# Generated by provision-env.sh (upstream generate-keys.sh); never edit by hand. Legacy HS256 JWT secret.
JWT_SECRET=generated-by-provision-env
# Generated by provision-env.sh (upstream generate-keys.sh); never edit by hand. Legacy HS256 anon API key (public by design).
ANON_KEY=generated-by-provision-env
# Generated by provision-env.sh (upstream generate-keys.sh); never edit by hand. Legacy HS256 service role API key; server side only.
SERVICE_ROLE_KEY=generated-by-provision-env
# Generated by provision-env.sh (upstream generate-keys.sh); never edit by hand. Studio dashboard password.
DASHBOARD_PASSWORD=generated-by-provision-env
# Generated by provision-env.sh (upstream generate-keys.sh); never edit by hand. Encryption key for Realtime and Supavisor.
SECRET_KEY_BASE=generated-by-provision-env
# Generated by provision-env.sh (upstream generate-keys.sh); never edit by hand. Encryption key for sensitive Realtime fields.
REALTIME_DB_ENC_KEY=generated-by-provision-env
# Generated by provision-env.sh (upstream generate-keys.sh); never edit by hand. Encryption key for Supavisor configuration.
VAULT_ENC_KEY=generated-by-provision-env
# Generated by provision-env.sh (upstream generate-keys.sh); never edit by hand. Encryption key for Studio connection strings.
PG_META_CRYPTO_KEY=generated-by-provision-env
# Generated by provision-env.sh (upstream generate-keys.sh); never edit by hand. Log ingestion token for Logflare and Vector.
LOGFLARE_PUBLIC_ACCESS_TOKEN=generated-by-provision-env
# Generated by provision-env.sh (upstream generate-keys.sh); never edit by hand. Logflare management token.
LOGFLARE_PRIVATE_ACCESS_TOKEN=generated-by-provision-env
# Generated by provision-env.sh (upstream generate-keys.sh); never edit by hand. Access key id of the Storage S3 protocol endpoint.
S3_PROTOCOL_ACCESS_KEY_ID=generated-by-provision-env
# Generated by provision-env.sh (upstream generate-keys.sh); never edit by hand. Secret key of the Storage S3 protocol endpoint.
S3_PROTOCOL_ACCESS_KEY_SECRET=generated-by-provision-env
# Generated by provision-env.sh (upstream generate-keys.sh); never edit by hand. Unused MinIO root password (upstream requires the variable).
MINIO_ROOT_PASSWORD=generated-by-provision-env
# Generated by provision-env.sh (openssl rand -hex 32): restic repository password. Losing it loses the backups; keep a copy in the password manager.
RESTIC_PASSWORD=generated-by-provision-env

############
# URLs (set by provision-env.sh)
############

# Filled by provision-env.sh: public URL of the environment.
SUPABASE_PUBLIC_URL=set-by-provision-env
# Filled by provision-env.sh: public URL + /auth/v1 (GoTrue external URL, used for OAuth callbacks and e-mail links).
API_EXTERNAL_URL=set-by-provision-env

############
# Asymmetric keys (not used: legacy HS256 keys only)
############

# Not used: legacy HS256 keys only. Leave empty.
SUPABASE_PUBLISHABLE_KEY=
# Not used: legacy HS256 keys only. Leave empty.
SUPABASE_SECRET_KEY=
# Not used: legacy HS256 keys only. Leave empty.
JWT_KEYS=
# Not used: legacy HS256 keys only. Leave empty.
JWT_JWKS=
# Not used: legacy HS256 keys only. Leave empty.
ANON_KEY_ASYMMETRIC=
# Not used: legacy HS256 keys only. Leave empty.
SERVICE_ROLE_KEY_ASYMMETRIC=

############
# Database
############

# Fixed: Postgres service name inside the Compose network.
POSTGRES_HOST=db
# Fixed: default database name.
POSTGRES_DB=postgres
# Fixed: Postgres port inside the container.
POSTGRES_PORT=5432
# Fixed: Supavisor transaction port (not published on the host).
POOLER_PROXY_PORT_TRANSACTION=6543
# Fixed: upstream default pool size.
POOLER_DEFAULT_POOL_SIZE=20
# Fixed: upstream default max client connections.
POOLER_MAX_CLIENT_CONN=100
# Fixed: Supavisor tenant identifier.
POOLER_TENANT_ID=estaca
# Fixed: upstream default metadata pool size.
POOLER_DB_POOL_SIZE=5

############
# Studio
############

# Fixed: Studio dashboard user.
DASHBOARD_USERNAME=estaca
# Fixed: organization name shown in Studio.
STUDIO_DEFAULT_ORGANIZATION=Estaca Criciuma
# Fixed: project name shown in Studio.
STUDIO_DEFAULT_PROJECT=Estaca Criciuma
# Fixed: empty, the Studio AI assistant stays off.
OPENAI_API_KEY=

############
# Auth (GoTrue)
############

# Fixed: app deep link scheme used as the Site URL.
SITE_URL=estacacriciuma://
# Fixed: allowed redirect after login.
ADDITIONAL_REDIRECT_URLS=estacacriciuma://auth-callback
# Fixed: upstream default access token lifetime (seconds).
JWT_EXPIRY=3600
# Fixed: OTP login creates the account on first use.
DISABLE_SIGNUP=false
# Fixed: upstream default e-mail link path.
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
# Fixed: upstream default e-mail link path.
MAILER_URLPATHS_INVITE="/auth/v1/verify"
# Fixed: upstream default e-mail link path.
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
# Fixed: upstream default e-mail link path.
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"
# Fixed: e-mail OTP login.
ENABLE_EMAIL_SIGNUP=true
# Fixed: e-mail must be confirmed through the OTP.
ENABLE_EMAIL_AUTOCONFIRM=false
# Fixed: no anonymous sign-ins.
ENABLE_ANONYMOUS_USERS=false
# Fixed: no phone login.
ENABLE_PHONE_SIGNUP=false
# Fixed: no phone login.
ENABLE_PHONE_AUTOCONFIRM=false

############
# SMTP (Resend)
############

# Fixed: sender address of auth e-mails.
SMTP_ADMIN_EMAIL=nao-responda@estacacriciuma.com.br
# Fixed: Resend SMTP host.
SMTP_HOST=smtp.resend.com
# Fixed: Resend SMTP port (implicit TLS).
SMTP_PORT=465
# Fixed: Resend SMTP user.
SMTP_USER=resend
# Pasted manually: Resend API key (runbook item e). Never commit.
SMTP_PASS=fill-in-manually
# Fixed: sender display name.
SMTP_SENDER_NAME="Estaca Criciúma"

############
# Google and Apple sign-in (filled by the auth-account spec)
############

# Set by auth-account: turns the Google provider on.
GOOGLE_ENABLED=false
# Set by auth-account: Google OAuth client id.
GOOGLE_CLIENT_ID=
# Set by auth-account: Google OAuth client secret.
GOOGLE_SECRET=
# Set by auth-account: turns the Apple provider on.
APPLE_ENABLED=false
# Set by auth-account: Apple services id.
APPLE_CLIENT_ID=
# Set by auth-account: Apple client secret (JWT).
APPLE_SECRET=

############
# Storage
############

# Fixed: upstream value for the file storage backend.
GLOBAL_S3_BUCKET=stub
# Fixed: upstream value.
REGION=stub
# Fixed: unused MinIO user (upstream requires the variable).
MINIO_ROOT_USER=supa-storage
# Fixed: upstream value.
STORAGE_TENANT_ID=stub

############
# Edge Functions
############

# Fixed: upstream default; functions verify the JWT themselves.
FUNCTIONS_VERIFY_JWT=false
# Fixed: upstream default memory limit of the functions container.
FUNCTIONS_MEMORY_LIMIT=2g

############
# API (PostgREST)
############

# Fixed: schemas exposed by the REST API.
PGRST_DB_SCHEMAS=public,graphql_public
# Fixed: max rows per request.
PGRST_DB_MAX_ROWS=1000
# Fixed: extra search_path schema.
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# Logs and analytics
############

# Fixed: Docker socket read by Vector.
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
# Fixed: upstream placeholder (unused by self-hosted).
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
# Fixed: upstream placeholder (unused by self-hosted).
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER

############
# API gateway
############

# Fixed: ignored, the override publishes HOST_GW_PORT on 127.0.0.1.
API_GW_HTTP_PORT=8000
# Fixed: upstream fallback, unused with Envoy.
KONG_HTTP_PORT=8000
# Fixed: upstream value, unused with Envoy.
KONG_HTTPS_PORT=8443

############
# imgproxy
############

# Fixed: upstream default.
IMGPROXY_AUTO_WEBP=true

############
# Upstream TLS proxy (unused: Caddy runs on the host)
############

# Fixed: unused, upstream proxy overrides are not loaded.
PROXY_DOMAIN=unused.invalid
# Fixed: unused, upstream proxy overrides are not loaded.
CERTBOT_EMAIL=unused@invalid.example

############
# Backup and monitoring (pasted manually, runbook items d and h)
############

# Pasted manually: Oracle Object Storage S3 endpoint (https://<namespace>.compat.objectstorage.<region>.oraclecloud.com).
OCI_S3_ENDPOINT=fill-in-manually
# Pasted manually: Oracle region identifier (for example sa-saopaulo-1).
OCI_REGION=fill-in-manually
# Pasted manually: bucket that holds the restic repositories.
OCI_BUCKET=fill-in-manually
# Pasted manually: Object Storage customer secret key id.
AWS_ACCESS_KEY_ID=fill-in-manually
# Pasted manually: Object Storage customer secret key.
AWS_SECRET_ACCESS_KEY=fill-in-manually
# Pasted manually: Healthchecks.io ping URL of this environment backup check.
HEALTHCHECKS_URL=fill-in-manually
